<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <clear />
      <add name="LegacyStaticFile" path="*" verb="*" modules="StaticFileModule" resourceType="Either" requireAccess="Read" />
    </handlers>
    <!-- Keep the legacy host outside ASP.NET Core so IIS does not start the same app twice. -->
    <httpRedirect
      enabled="true"
      destination="https://elysium.zarcanist.com$V$Q"
      exactDestination="true"
      childOnly="false"
      httpResponseStatus="PermRedirect" />
  </system.webServer>
  <!-- Serve ACME tokens natively so validation never starts another managed app in the shared pool. -->
  <location path=".well-known/acme-challenge">
    <system.webServer>
      <httpRedirect enabled="false" />
      <handlers>
        <clear />
        <add name="AcmeStaticFile" path="*" verb="GET,HEAD" modules="StaticFileModule" resourceType="File" requireAccess="Read" />
      </handlers>
    </system.webServer>
  </location>
</configuration>
