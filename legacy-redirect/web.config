<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Keep the legacy host outside ASP.NET Core so IIS does not start the same app twice. -->
    <httpRedirect
      enabled="true"
      destination="https://elysium.zarcanist.com$V$Q"
      exactDestination="true"
      childOnly="false"
      httpResponseStatus="PermRedirect" />
  </system.webServer>
</configuration>
